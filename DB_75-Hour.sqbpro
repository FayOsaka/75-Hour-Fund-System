-- 1. ตาราง user: ข้อมูลนักศึกษา
CREATE TABLE &quot;user&quot; (
    user_id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_sduID TEXT UNIQUE NOT NULL
        CHECK (LENGTH(user_sduID) = 14),
    user_firstname TEXT NOT NULL
        CHECK (LENGTH(user_firstname) &lt;= 100),
    user_lastname TEXT NOT NULL
        CHECK (LENGTH(user_lastname) &lt;= 100),
    user_phone TEXT NOT NULL
        CHECK (LENGTH(user_phone) = 10),
    user_faculty TEXT NOT NULL
        CHECK (LENGTH(user_faculty) &lt;= 150),
    user_major TEXT NOT NULL
        CHECK (LENGTH(user_major) &lt;= 150),
    user_password TEXT NOT NULL
        CHECK (LENGTH(user_password) &lt;= 255)
);

-- 2. ตาราง admin: ข้อมูลผู้ดูแลระบบ
CREATE TABLE admin (
    admin_id INTEGER PRIMARY KEY AUTOINCREMENT,
    admin_firstname TEXT NOT NULL
        CHECK (LENGTH(admin_firstname) &lt;= 100),
    admin_lastname TEXT NOT NULL
        CHECK (LENGTH(admin_lastname) &lt;= 100),
    admin_password TEXT NOT NULL
        CHECK (LENGTH(admin_password) &lt;= 255)
);

-- 3. ตาราง project: ข้อมูลโครงการ
CREATE TABLE project (
    project_id INTEGER PRIMARY KEY AUTOINCREMENT,
    project_name TEXT NOT NULL
        CHECK (LENGTH(project_name) &lt;= 255)
);

-- 4. ตาราง mapping_project_user: ข้อมูลการสมัครโครงการ
CREATE TABLE mapping_project_user (
    mapping_id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    project_id INTEGER NOT NULL,

    FOREIGN KEY (user_id)
        REFERENCES &quot;user&quot;(user_id),

    FOREIGN KEY (project_id)
        REFERENCES project(project_id),

    UNIQUE (user_id, project_id)
);

-- 5. ตาราง work_logs: บันทึกเวลาทำงาน
CREATE TABLE work_logs (
    work_logs_id INTEGER PRIMARY KEY AUTOINCREMENT,
    mapping_id INTEGER NOT NULL,
    work_logs_date TEXT NOT NULL,
    work_logs_timein TEXT NOT NULL,
    work_logs_timeout TEXT NOT NULL,
    work_logs_detail TEXT,
    work_logs_status TEXT DEFAULT 'pending'
        CHECK (
            work_logs_status IS NULL
            OR LENGTH(work_logs_status) &lt;= 50
        ),

    FOREIGN KEY (mapping_id)
        REFERENCES mapping_project_user(mapping_id)
);
</sql><current_tab id="0"/></tab_sql></sqlb_project>
